DATABASE_URL=postgresql+asyncpg://guideverse:change-me@localhost:5432/guideverse
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
# Development only: UUID of an existing provider used before authentication is connected.
DEV_PROVIDER_ID=
FRONTEND_URL=http://localhost:5173

# Stripe test mode. Configure a webhook for /api/payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Developer sandbox app credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional local testing reference; use a PayPal Sandbox buyer account for checkout.
PAYPAL_SANDBOX_BUYER_EMAIL=


# SMTP settings for booking confirmation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Social authentication. Register the callback URLs shown in the README/API UI.
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
